{
  "case": "10-cost-coverage",
  "scenarios": [
    {
      "name": "valid_attached_rate_is_an_estimate_not_provider_billed",
      "render": {
        "context_window_size": 100000,
        "context_model": "memnoth-default",
        "context_provider": "memnoth",
        "context_window_source": "catalog",
        "next_turn_effort": null
      },
      "receipts": [
        {
          "at_ms": 1000,
          "turn_id": 0,
          "total_tokens": 100,
          "prefix_hash": "m1",
          "layer_tokens": [25, 25, 25, 25],
          "pieces": 4,
          "input_tokens": 80,
          "output_tokens": 20,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0,
          "context_window_model": "memnoth-default",
          "context_window_provider": "memnoth",
          "provider_id": "memnoth",
          "provider_usage_reported": true,
          "provider_input_reported": true,
          "provider_output_reported": true,
          "cost_micros": 1234
        }
      ],
      "expect": {
        "json": {
          "cost.status": "estimate",
          "cost.priced_turns": 1,
          "cost.total_turns": 1,
          "cost.source": "local model/config price table; not provider-billed cost",
          "latest_turn.cost_estimate_usd": 0.001234
        },
        "text_contains": [
          "~$0.001234 estimate",
          "1/1 priced turns",
          "estimate",
          "not provider-billed cost"
        ],
        "text_not_contains": []
      }
    },
    {
      "name": "missing_rate_stays_unknown",
      "render": {
        "context_window_size": 100000,
        "context_model": "memnoth-default",
        "context_provider": "memnoth",
