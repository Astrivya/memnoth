      "render": {
        "context_window_size": 128000,
        "context_model": "gpt-5.4",
        "context_provider": "openai",
        "context_window_source": "catalog",
        "next_turn_effort": null
      },
      "receipts": [
        {
          "at_ms": 1000,
          "total_tokens": 0,
          "prefix_hash": "legacy",
          "layer_tokens": [0, 0, 0, 0],
          "pieces": 0,
          "input_tokens": 0,
          "output_tokens": 0,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0
        }
      ],
      "expect": {
        "json": {
          "latest_turn.provider": null,
          "latest_turn.provider_status": "not recorded",
          "latest_turn.model": null,
          "latest_turn.effort": null,
          "latest_turn.input_tokens.status": "not reported",
          "latest_turn.input_tokens.value": null,
          "latest_turn.output_tokens.status": "not reported",
